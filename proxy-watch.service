# Install with the sed command in README.md — it fills in @REPO_DIR@ with your clone path.
[Unit]
Description=Re-establish proxy steering after WireGuard/network outages
After=network-online.target docker.service proxy-primer.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=@REPO_DIR@/scripts/proxy-watch.sh
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
